# ─── Bot ───────────────────────────────────────────────────────────────
BOT_TOKEN=7123456789:AAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=my_store_bot

# ─── Admins ────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs with super-admin access
SUPER_ADMIN_IDS=123456789,987654321

# ─── Database ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=telestore

# ─── Webhook (set USE_WEBHOOK=true for production, false for polling) ──
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# ─── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─── Encryption ────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# ─── OxaPay (optional, per-store) ──────────────────────────────────────
# Store owners enter their own keys via settings. This is the platform default.
OXAPAY_MERCHANT_KEY=
OXAPAY_CALLBACK_URL=https://your-domain.com/oxapay/webhook

# ─── Telegram Stars ────────────────────────────────────────────────────
STARS_ENABLED=true
# How many Stars = 1 INR (default: 1 star = 1 INR for simplicity)
STARS_PER_INR=1

# ─── Platform ──────────────────────────────────────────────────────────
PLATFORM_NAME=TeleStore

# ─── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=60
